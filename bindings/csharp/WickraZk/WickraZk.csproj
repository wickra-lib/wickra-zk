<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Wickra.Zk</RootNamespace>
    <AssemblyName>Wickra.Zk</AssemblyName>

    <PackageId>Wickra.Zk</PackageId>
    <Version>0.1.3</Version>
    <Authors>kingchenc</Authors>
    <Description>Zero-knowledge proofs of backtest performance for .NET over the Wickra C ABI: create a Prover, prove a (strategy, candles) pair to a RISC Zero receipt and a public journal, and verify a receipt without seeing the data or the strategy behind it.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wickra-lib/wickra-zk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wickra-lib/wickra-zk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>trading;backtest;proof;determinism;blake3;ffi;native</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5128;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The native library does not travel in this package. The prover library is
    ~90 MB per platform (the RISC Zero prover and its circuits live inside it)
    and NuGet.org caps a package at 250 MB, so the four supported RIDs,
    linux-x64, linux-arm64, osx-x64, osx-arm64 (no Windows, risc0 has no
    Windows host), ship as Wickra.Zk.runtime.<rid> (WickraZk.Runtime.csproj),
    and this package depends on all four. A consumer still gets every platform
    with one `dotnet add package Wickra.Zk`, and `dotnet run` without a
    RuntimeIdentifier still finds the library through deps.json.

    The references exist only when the release pipeline packs
    (PackNativeRuntimes=true): the runtime packages are produced in the same
    run and restored from a local feed, and a plain build or the test project
    would otherwise ask NuGet.org for packages that ship together with this one.
  -->
  <ItemGroup Condition="'$(PackNativeRuntimes)' == 'true'">
    <PackageReference Include="Wickra.Zk.runtime.linux-x64" Version="$(Version)" />
    <PackageReference Include="Wickra.Zk.runtime.linux-arm64" Version="$(Version)" />
    <PackageReference Include="Wickra.Zk.runtime.osx-x64" Version="$(Version)" />
    <PackageReference Include="Wickra.Zk.runtime.osx-arm64" Version="$(Version)" />
  </ItemGroup>

</Project>
